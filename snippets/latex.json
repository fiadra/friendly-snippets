  },
  "Outer product (column x row)": {
    "prefix": "matcolrow",
    "body": [
      "\\begin{pmatrix}",
      "${1:x}_1 \\\\\\",
      "${1:x}_2 \\\\\\",
      "\\vdots \\\\\\",
      "${1:x}_${2:m}",
      "\\end{pmatrix}",
      "\\begin{pmatrix}",
      "${3:y}_1 & ${3:y}_2 & \\cdots & ${3:y}_${4:n}",
      "\\end{pmatrix}",
      "=",
      "\\begin{pmatrix}",
      "${1:x}_1${3:y}_1 & ${1:x}_1${3:y}_2 & \\cdots & ${1:x}_1${3:y}_${4:n} \\\\\\",
      "${1:x}_2${3:y}_1 & ${1:x}_2${3:y}_2 & \\cdots & ${1:x}_2${3:y}_${4:n} \\\\\\",
      "\\vdots & \\vdots & \\ddots & \\vdots \\\\\\",
      "${1:x}_${2:m}${3:y}_1 & ${1:x}_${2:m}${3:y}_2 & \\cdots & ${1:x}_${2:m}${3:y}_${4:n}",
      "\\end{pmatrix}"
    ],
    "description": "Outer product of column and row vector (editable symbols and dimensions)"
  },
  "Matrix multiplication (generic)": {
    "prefix": "matmul",
    "body": [
      "\\begin{pmatrix}",
      "${1:a}_{11} & \\cdots & ${1:a}_{1${3:k}} \\\\\\",
      "\\vdots & \\ddots & \\vdots \\\\\\",
      "${1:a}_{{${2:m}}1} & \\cdots & ${1:a}_{{${2:m}}${3:k}}",
      "\\end{pmatrix}",
      "\\begin{pmatrix}",
      "${4:b}_{11} & \\cdots & ${4:b}_{1${6:n}} \\\\\\",
      "\\vdots & \\ddots & \\vdots \\\\\\",
      "${4:b}_{{${3:k}}1} & \\cdots & ${4:b}_{{${3:k}}${6:n}}",
      "\\end{pmatrix}"
    ],
    "description": "Generic matrix product A(mxk)B(nxp)"
  },

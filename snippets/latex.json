  "Generic nxn matrix": {
    "prefix": "matnn",
    "body": [
      "\\begin{pmatrix}",
      "${1:a}_{11} & ${1:a}_{12} & \\cdots & ${1:a}_{1${2:n}} \\\\\\",
      "${1:a}_{21} & ${1:a}_{22} & \\cdots & ${1:a}_{2${2:n}} \\\\\\",
      "\\vdots & \\vdots & \\ddots & \\vdots \\\\\\",
      "${1:a}_{{${2:n}}1} & ${1:a}_{{${2:n}}2} & \\cdots & ${1:a}_{{${2:n}}${2:n}}",
      "\\end{pmatrix}"
    ],
    "description": "Generic n x n matrix (editable symbol)"
  },
  "Diagonal matrix": {
    "prefix": "matdiag",
    "body": [
      "\\begin{pmatrix}",
      "${1:d}_1 & 0 & \\cdots & 0 \\\\\\",
      "0 & ${1:d}_2 & \\cdots & 0 \\\\\\",
      "\\vdots & \\vdots & \\ddots & \\vdots \\\\\\",
      "0 & 0 & \\cdots & ${1:d}_${2:n}",
      "\\end{pmatrix}"
    ],
    "description": "Diagonal matrix (editable symbol)"
  },
  "Generic mxn matrix": {
    "prefix": "matmn",
    "body": [
      "\\begin{pmatrix}",
      "${1:a}_{11} & ${1:a}_{12} & \\cdots & ${1:a}_{1${3:n}} \\\\\\",
      "${1:a}_{21} & ${1:a}_{22} & \\cdots & ${1:a}_{2${3:n}} \\\\\\",
      "\\vdots & \\vdots & \\ddots & \\vdots \\\\\\",
      "${1:a}_{{${2:m}}1} & ${1:a}_{{${2:m}}2} & \\cdots & ${1:a}_{{${2:m}}${3:n}}",
      "\\end{pmatrix}"
    ],
    "description": "Generic m x n matrix (editable symbol, m, n)"
  },
  "Upper triangular matrix": {
    "prefix": "matup",
    "body": [
      "\\begin{pmatrix}",
      "${1:a}_{11} & ${1:a}_{12} & \\cdots & ${1:a}_{1${2:n}} \\\\\\",
      "0 & ${1:a}_{22} & \\cdots & ${1:a}_{2${2:n}} \\\\\\",
      "\\vdots & \\vdots & \\ddots & \\vdots \\\\\\",
      "0 & 0 & \\cdots & ${1:a}_{{${2:n}}${2:n}}",
